{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hlasm",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "statement"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "repro_data"
        },
        {
          "type": "SYMBOL",
          "name": "_blank"
        }
      ]
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "name"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_blank"
        },
        {
          "type": "FIELD",
          "name": "operation",
          "content": {
            "type": "SYMBOL",
            "name": "operation"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_blank"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "CHOICE",
                      "members": [
                        {
                          "type": "SEQ",
                          "members": [
                            {
                              "type": "FIELD",
                              "name": "operands",
                              "content": {
                                "type": "SYMBOL",
                                "name": "operands"
                              }
                            },
                            {
                              "type": "CHOICE",
                              "members": [
                                {
                                  "type": "SEQ",
                                  "members": [
                                    {
                                      "type": "SYMBOL",
                                      "name": "_blank"
                                    },
                                    {
                                      "type": "CHOICE",
                                      "members": [
                                        {
                                          "type": "FIELD",
                                          "name": "remarks",
                                          "content": {
                                            "type": "SYMBOL",
                                            "name": "remarks"
                                          }
                                        },
                                        {
                                          "type": "BLANK"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "BLANK"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "FIELD",
                          "name": "remarks",
                          "content": {
                            "type": "ALIAS",
                            "content": {
                              "type": "SYMBOL",
                              "name": "_operand_field_remarks"
                            },
                            "named": true,
                            "value": "remarks"
                          }
                        }
                      ]
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "operands": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_operand"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_next_operand"
              }
            }
          ]
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_next_operand"
          }
        }
      ]
    },
    "_next_operand": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ","
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_blank"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "FIELD",
                        "name": "remarks",
                        "content": {
                          "type": "ALIAS",
                          "content": {
                            "type": "SYMBOL",
                            "name": "_operand_remark"
                          },
                          "named": true,
                          "value": "remarks"
                        }
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operand"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_operand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword_operand"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "keyword_operand": {
      "type": "PREC_RIGHT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "key",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_word"
              },
              "named": true,
              "value": "keyword"
            }
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "value",
                "content": {
                  "type": "SYMBOL",
                  "name": "expression"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "expression": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "_term"
        }
      }
    },
    "_term": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_list_item"
              },
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_blank"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_list_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword_operand"
        },
        {
          "type": "SYMBOL",
          "name": "_term"
        }
      ]
    },
    "name": {
      "type": "SYMBOL",
      "name": "_field"
    },
    "operation": {
      "type": "SYMBOL",
      "name": "_field"
    },
    "word": {
      "type": "SYMBOL",
      "name": "_word"
    },
    "operator": {
      "type": "PATTERN",
      "value": "[=+\\-*\\/<>¬|!?:;%\"\\\\]"
    },
    "remarks": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_remark"
      }
    },
    "_operand_field_remarks": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_operand_field_remark"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_remark"
          }
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_line"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_remark"
          }
        }
      ]
    },
    "_blank": {
      "type": "PATTERN",
      "value": "[ \\t\\x00]+"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "continuation"
    },
    {
      "type": "SYMBOL",
      "name": "sequence_number"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_word"
    },
    {
      "type": "SYMBOL",
      "name": "string"
    },
    {
      "type": "SYMBOL",
      "name": "_remark"
    },
    {
      "type": "SYMBOL",
      "name": "_operand_remark"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_line"
    },
    {
      "type": "SYMBOL",
      "name": "continuation"
    },
    {
      "type": "SYMBOL",
      "name": "sequence_number"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    },
    {
      "type": "SYMBOL",
      "name": "_field"
    },
    {
      "type": "SYMBOL",
      "name": "_operand_field_remark"
    },
    {
      "type": "SYMBOL",
      "name": "repro_data"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}